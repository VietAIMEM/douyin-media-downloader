# Dependencies
node_modules/
src-tauri/target/

# Build output
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local agent/editor configuration for this checkout. Holds a dev-server launch
# description and per-machine settings; nothing the application builds or runs
# reads it.
.claude/

# Throwaway development helpers: one-off scripts that rewrite source files by
# string replacement. Kept narrow on purpose — only dot-prefixed `patch*.py`
# files under src-tauri/ match, so real scripts such as `make_icons.py` and
# every application source file are unaffected.
src-tauri/.patch*.py

# Logs
*.log
logs/

# Environment
.env
.env.*
!.env.example

# The application's database and its sidecars.
#
# These live in the per-user data directory, never in the tree, but a copy
# dropped here by hand — by a test run, or by pointing the app at a local data
# directory — would be a record of somebody's real downloads. Ignored by name so
# that cannot be committed by accident.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Release signing material.
#
# The updater's private key signs every package an installed copy will accept as
# an update, so it is the one file here whose exposure would let somebody else
# ship an "update" to every installation. It belongs in a local secret store or
# a CI secret, never in the repository. Only the matching public key may be
# committed, and even that is not needed to build.
.release-keys/
*.key
*.key.pub
*.pem
*.pfx
*.p12

# Assembled release artifacts: installers, updater packages, their signatures,
# checksums and the channel manifest. Regenerated by `npm run release`.
release/
