{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Douyin Downloader",
  "version": "1.0.1",
  "identifier": "com.douyindownloader.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Douyin Downloader",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Douyin Downloader",
    "category": "Utility",
    "shortDescription": "Download publicly accessible Douyin media.",
    "longDescription": "A desktop application for downloading publicly accessible Douyin media. It resolves a post or profile, downloads the media over ordinary HTTP, and keeps a local library of what it has saved. It does not sign in, solve challenges, or access content that is not publicly available.",
    "copyright": "Douyin Downloader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": false
    }
  }
}
